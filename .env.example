# GEMINI_API_KEY: Optional Gemini API key (automatically injected by AI Studio if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed or preview application
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only Express session cookies
SESSION_SECRET=

# MONGODB_URI: Optional MongoDB connection string (falls back to ./data/borrowbox.json if omitted)
MONGODB_URI=

# ADMIN_EMAIL & ADMIN_PASSWORD: Optional initial Admin credentials
# If omitted, use the first-run Admin Setup form on /admin-login to create the initial admin securely.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# GOOGLE_CLIENT_ID & GOOGLE_CLIENT_SECRET: Optional Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
